# Infinite Tic-Tac-Toe Analyzer — Production Environment Template
# -----------------------------------------------------------------
# NOTE: This application is a fully client-side, local-first web app.
# The game-theoretic solver runs directly in the user's browser using
# an embedded binary retrograde tablebase.
#
# No external database, authentication provider, or third-party API keys
# are required for core functionality.
# -----------------------------------------------------------------

# Node environment ('development', 'production', or 'test')
NODE_ENV=production

# Public canonical URL (configured in Vercel project settings)
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app
